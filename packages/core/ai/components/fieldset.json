{
  "name": "fieldset",
  "title": "字段组",
  "titleEn": "Fieldset",
  "category": "form",
  "summary": "用 legend 给一组相关控件起标题，可做成缝线卡片。",
  "when": "一组单选/复选框，或把长表单分成几个小节。",
  "root": "riko-fieldset",
  "element": "fieldset",
  "parts": [
    {
      "class": "riko-fieldset__legend",
      "desc": "标题（<legend>）",
      "required": true
    },
    {
      "class": "riko-fieldset__desc",
      "desc": "说明文字"
    }
  ],
  "modifiers": [
    {
      "class": "riko-fieldset--inline",
      "desc": "选项横向排列",
      "group": "layout"
    },
    {
      "class": "riko-fieldset--card",
      "desc": "缝线卡片外框",
      "group": "variant"
    }
  ],
  "states": [
    {
      "attr": "disabled",
      "desc": "整组禁用（原生行为）"
    }
  ],
  "js": null,
  "a11y": [
    "用原生 <fieldset> + <legend>，读屏会在每个选项前读出组名。"
  ],
  "rules": [
    "单选组、复选组一律放进 fieldset。"
  ],
  "avoid": [
    "不要用 div + 标题代替 fieldset/legend。"
  ],
  "examples": [
    {
      "title": "基础",
      "html": "<fieldset class=\"riko-fieldset\">\n  <legend class=\"riko-fieldset__legend\">喜欢的点心</legend>\n  <p class=\"riko-fieldset__desc\">可以多选哦</p>\n  <label class=\"riko-checkbox\"><input type=\"checkbox\" checked> 星星酥</label>\n  <label class=\"riko-checkbox\"><input type=\"checkbox\"> 海盐饼干</label>\n</fieldset>"
    },
    {
      "title": "卡片",
      "html": "<fieldset class=\"riko-fieldset riko-fieldset--card\">\n  <legend class=\"riko-fieldset__legend\"><span class=\"riko-star\" aria-hidden=\"true\"></span>通知设置</legend>\n  <label class=\"riko-switch riko-switch--end\"><input type=\"checkbox\" role=\"switch\" checked> 新章节更新</label>\n  <label class=\"riko-switch riko-switch--end\"><input type=\"checkbox\" role=\"switch\"> 设定集更新</label>\n</fieldset>"
    }
  ],
  "requires": [
    {
      "selector": ".riko-fieldset",
      "has": "legend",
      "message": "riko-fieldset 需要 <legend class=\"riko-fieldset__legend\">"
    },
    {
      "selector": ".riko-fieldset",
      "message": "riko-fieldset 必须用 <fieldset> 元素",
      "tag": "fieldset"
    }
  ],
  "related": [
    "form",
    "checkbox",
    "radio"
  ]
}