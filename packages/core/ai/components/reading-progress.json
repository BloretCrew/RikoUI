{
  "name": "reading-progress",
  "title": "阅读进度条",
  "titleEn": "Reading Progress",
  "category": "navigation",
  "summary": "固定在页面顶部的细进度条（冰蓝到橙色渐变），显示整页或某篇文章的阅读进度。",
  "when": "小说、长文章阅读页。表示任务/上传进度请用 progress。",
  "root": "riko-reading-progress",
  "element": "div",
  "parts": [],
  "modifiers": [
    {
      "class": "riko-reading-progress--static",
      "desc": "不固定定位、带底色的进度条",
      "group": "layout"
    }
  ],
  "states": [],
  "js": {
    "attr": "data-riko=\"reading-progress\"",
    "options": [
      {
        "attr": "data-riko-target",
        "values": "CSS 选择器",
        "default": "",
        "desc": "只计算该元素（如文章正文）的阅读进度"
      }
    ],
    "methods": [
      {
        "signature": "el.riko.update()",
        "desc": "重新计算"
      },
      {
        "signature": "el.riko.progress",
        "desc": "当前进度 0–1"
      }
    ],
    "events": [
      {
        "name": "riko:reading-progress:change",
        "detail": "{ progress }",
        "desc": "进度变化"
      }
    ]
  },
  "a11y": [
    "默认是装饰（aria-hidden）；加 aria-label 后会变成 role=\"progressbar\" 并维护 aria-valuenow。"
  ],
  "rules": [
    "进度写在 CSS 变量 --riko-progress（0–1）上，也可以手动设置。",
    "高度可用 --riko-reading-progress-h 调整。"
  ],
  "avoid": [],
  "examples": [
    {
      "title": "阅读进度条",
      "html": "<div class=\"riko-reading-progress riko-reading-progress--static\" style=\"--riko-progress: .62\"></div>"
    }
  ],
  "requires": [
    {
      "selector": ".riko-reading-progress[role=\"progressbar\"]",
      "attr": "aria-label|aria-labelledby",
      "message": "role=\"progressbar\" 的阅读进度条需要 aria-label"
    }
  ],
  "related": [
    "backtop",
    "progress"
  ]
}
