{
  "name": "dropdown",
  "title": "下拉菜单",
  "titleEn": "Dropdown Menu",
  "category": "navigation",
  "summary": "点击按钮弹出的操作菜单（riko-menu），支持图标、快捷键、分组标题、分隔线、勾选项与危险操作。",
  "when": "收纳次要操作或选项。需要从列表里选一个值并提交表单时用 select / combobox；悬停提示用 tooltip。",
  "root": "riko-dropdown",
  "element": "div",
  "parts": [
    {
      "class": "riko-menu",
      "desc": "菜单面板（role=\"menu\"，初始 hidden）",
      "required": true
    },
    {
      "class": "riko-menu__item",
      "desc": "菜单项（button 或 a，role=\"menuitem\" / menuitemcheckbox / menuitemradio）",
      "required": true
    },
    {
      "class": "riko-menu__icon",
      "desc": "项前图标容器"
    },
    {
      "class": "riko-menu__shortcut",
      "desc": "右侧快捷键提示（<kbd>）"
    },
    {
      "class": "riko-menu__desc",
      "desc": "项内第二行说明"
    },
    {
      "class": "riko-menu__label",
      "desc": "分组标题"
    },
    {
      "class": "riko-menu__separator",
      "desc": "分隔线（<hr>）"
    },
    {
      "class": "riko-menu__danger",
      "desc": "危险操作项：与 riko-menu__item 同时写在同一元素上"
    }
  ],
  "modifiers": [
    {
      "class": "riko-dropdown--no-caret",
      "desc": "触发按钮不显示下拉箭头",
      "group": "decor"
    }
  ],
  "states": [
    {
      "attr": "aria-expanded=\"true\"",
      "on": "[aria-haspopup]",
      "desc": "菜单打开（JS 维护）"
    },
    {
      "attr": "aria-checked=\"true\"",
      "on": "riko-menu__item",
      "desc": "勾选项被选中"
    },
    {
      "attr": "disabled",
      "on": "riko-menu__item",
      "desc": "不可用项"
    },
    {
      "attr": "hidden",
      "on": "riko-menu",
      "desc": "菜单关闭"
    }
  ],
  "js": {
    "attr": "data-riko=\"dropdown\"",
    "options": [
      {
        "attr": "data-riko-placement",
        "values": "bottom-start | bottom-end | bottom | top-start | top-end | right-start | left-start …",
        "default": "bottom-start",
        "desc": "菜单相对按钮的位置（空间不足自动翻转）"
      },
      {
        "attr": "data-riko-keep-open",
        "values": "（写在菜单项上）",
        "default": "",
        "desc": "选择该项后不关闭菜单"
      }
    ],
    "methods": [
      {
        "signature": "el.riko.open() / close() / toggle()",
        "desc": "开关菜单"
      },
      {
        "signature": "el.riko.isOpen",
        "desc": "是否打开"
      }
    ],
    "events": [
      {
        "name": "riko:dropdown:open",
        "desc": "菜单打开"
      },
      {
        "name": "riko:dropdown:close",
        "desc": "菜单关闭"
      },
      {
        "name": "riko:dropdown:select",
        "detail": "{ item, value, checked }",
        "desc": "选择菜单项（value 取 data-value 或文字）"
      }
    ]
  },
  "a11y": [
    "触发按钮需要 aria-haspopup=\"menu\"（JS 会补 aria-expanded / aria-controls）。",
    "键盘：↓/Enter/Space 打开并聚焦首项，↑ 打开并聚焦末项；菜单内 ↑↓ Home End、首字母跳转、Esc 关闭、Tab 离开。",
    "勾选项用 role=\"menuitemcheckbox|menuitemradio\" + aria-checked；单选项放进 role=\"group\"。"
  ],
  "rules": [
    "结构：.riko-dropdown 的直接子元素是触发按钮和 .riko-menu。",
    "菜单项是链接时用 <a class=\"riko-menu__item\" role=\"menuitem\" href>。",
    "危险项写 class=\"riko-menu__item riko-menu__danger\"。"
  ],
  "avoid": [
    "不要在菜单里放输入框等复杂控件（那是 popover）。",
    "不要用 riko-menu__item--danger（部件不能带修饰），改用 riko-menu__danger。"
  ],
  "examples": [
    {
      "title": "操作菜单",
      "html": "<div class=\"riko-dropdown\" data-riko=\"dropdown\">\n  <button type=\"button\" class=\"riko-btn\" aria-haspopup=\"menu\">更多操作</button>\n  <div class=\"riko-menu\" role=\"menu\" hidden>\n    <p class=\"riko-menu__label\">本节</p>\n    <button type=\"button\" class=\"riko-menu__item\" role=\"menuitem\"><span class=\"riko-menu__icon\"><i data-lucide=\"bookmark\"></i></span>加入书签<kbd class=\"riko-menu__shortcut\">B</kbd></button>\n    <button type=\"button\" class=\"riko-menu__item\" role=\"menuitem\"><span class=\"riko-menu__icon\"><i data-lucide=\"share-2\"></i></span>分享给朋友</button>\n    <a class=\"riko-menu__item\" role=\"menuitem\" href=\"#\"><span class=\"riko-menu__icon\"><i data-lucide=\"message-circle\"></i></span>去论坛讨论</a>\n    <hr class=\"riko-menu__separator\">\n    <button type=\"button\" class=\"riko-menu__item riko-menu__danger\" role=\"menuitem\"><span class=\"riko-menu__icon\"><i data-lucide=\"trash-2\"></i></span>清除阅读记录</button>\n  </div>\n</div>"
    },
    {
      "title": "勾选菜单（右对齐）",
      "html": "<div class=\"riko-dropdown\" data-riko=\"dropdown\" data-riko-placement=\"bottom-end\">\n  <button type=\"button\" class=\"riko-btn riko-btn--soft\" aria-haspopup=\"menu\"><i data-lucide=\"sliders-horizontal\"></i>阅读设置</button>\n  <div class=\"riko-menu\" role=\"menu\" hidden>\n    <button type=\"button\" class=\"riko-menu__item\" role=\"menuitemcheckbox\" aria-checked=\"true\" data-riko-keep-open>显示已读星星</button>\n    <button type=\"button\" class=\"riko-menu__item\" role=\"menuitemcheckbox\" aria-checked=\"false\" data-riko-keep-open>首行缩进</button>\n    <hr class=\"riko-menu__separator\">\n    <div role=\"group\" aria-label=\"字体\">\n      <p class=\"riko-menu__label\">字体</p>\n      <button type=\"button\" class=\"riko-menu__item\" role=\"menuitemradio\" aria-checked=\"true\" data-riko-keep-open>宋体（衬线）</button>\n      <button type=\"button\" class=\"riko-menu__item\" role=\"menuitemradio\" aria-checked=\"false\" data-riko-keep-open>黑体（无衬线）</button>\n    </div>\n  </div>\n</div>"
    }
  ],
  "requires": [
    {
      "selector": "[data-riko=\"dropdown\"]",
      "has": ".riko-menu",
      "message": "下拉菜单内需要 .riko-menu 面板"
    },
    {
      "selector": "[data-riko=\"dropdown\"]",
      "has": "[aria-haspopup]",
      "message": "下拉菜单的触发按钮需要 aria-haspopup=\"menu\""
    },
    {
      "selector": ".riko-menu__item",
      "parent": ".riko-menu",
      "message": "riko-menu__item 必须放在 riko-menu 内"
    }
  ],
  "related": [
    "popover",
    "select",
    "button"
  ]
}
