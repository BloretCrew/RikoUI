{
  "name": "sidenav",
  "title": "侧边目录",
  "titleEn": "Side Nav",
  "category": "navigation",
  "summary": "可折叠分组的侧边目录（小说章节、文档目录、设置分类），支持编号、已读星星、计数徽章。",
  "when": "内容有两级结构、需要长期显示目录时用。单层少量链接用 riko-toc；页面主导航用 navbar。",
  "root": "riko-sidenav",
  "element": "nav",
  "parts": [
    {
      "class": "riko-sidenav__heading",
      "desc": "目录标题（小字，可选）"
    },
    {
      "class": "riko-sidenav__group",
      "desc": "一个可折叠分组"
    },
    {
      "class": "riko-sidenav__group-toggle",
      "desc": "分组按钮（aria-expanded 控制展开）"
    },
    {
      "class": "riko-sidenav__badge",
      "desc": "分组编号徽章（文字或图标）"
    },
    {
      "class": "riko-sidenav__label",
      "desc": "分组标题；可内含 <small> 作为上方小字"
    },
    {
      "class": "riko-sidenav__count",
      "desc": "分组右侧计数"
    },
    {
      "class": "riko-sidenav__panel",
      "desc": "分组面板（紧跟在 toggle 之后）"
    },
    {
      "class": "riko-sidenav__list",
      "desc": "链接列表 <ul>"
    },
    {
      "class": "riko-sidenav__item",
      "desc": "目录项（a 或 button）；当前项 aria-current=\"page\""
    },
    {
      "class": "riko-sidenav__num",
      "desc": "手写编号，如 001"
    },
    {
      "class": "riko-sidenav__text",
      "desc": "项目文字（占满剩余宽度）"
    },
    {
      "class": "riko-sidenav__meta",
      "desc": "右侧小徽章（如搜索命中数）"
    },
    {
      "class": "riko-sidenav__dot",
      "desc": "已读星星（需 aria-label=\"已读\"）"
    }
  ],
  "modifiers": [
    {
      "class": "riko-sidenav--compact",
      "desc": "更紧凑的行高与徽章",
      "group": "size"
    }
  ],
  "states": [
    {
      "attr": "aria-expanded=\"true|false\"",
      "on": "riko-sidenav__group-toggle",
      "desc": "分组展开/收起"
    },
    {
      "attr": "aria-current=\"page\"",
      "on": "riko-sidenav__item",
      "desc": "当前项"
    },
    {
      "attr": "aria-disabled=\"true\"",
      "on": "riko-sidenav__item",
      "desc": "不可用的项"
    }
  ],
  "js": {
    "attr": "data-riko=\"sidenav\"",
    "options": [],
    "methods": [
      {
        "signature": "el.riko.expand(i) / collapse(i)",
        "desc": "展开/收起第 i 个分组（或传分组元素）"
      },
      {
        "signature": "el.riko.expandAll() / collapseAll()",
        "desc": "全部展开/收起"
      },
      {
        "signature": "el.riko.setCurrent(hrefOrEl)",
        "desc": "切换当前项，自动展开所在分组并滚动到可见"
      },
      {
        "signature": "el.riko.reveal()",
        "desc": "把当前项滚动到可见"
      }
    ],
    "events": [
      {
        "name": "riko:sidenav:toggle",
        "detail": "{ group, expanded }",
        "desc": "分组展开状态变化"
      }
    ]
  },
  "a11y": [
    "根元素用 <nav aria-label=\"…\">。",
    "分组按钮必须是 <button>，展开状态写在 aria-expanded 上。",
    "只用图标的 __badge 外层文字在 __label 中，不需额外 aria-label。"
  ],
  "rules": [
    "__panel 必须紧跟在 __group-toggle 之后（CSS 依赖相邻关系）。",
    "未写 aria-expanded 的分组：包含当前项则展开，否则收起。",
    "放在固定高度、overflow:auto 的容器里时，当前项会自动滚动到可见。"
  ],
  "avoid": [
    "不要用 .open / .active 类，改用 aria-expanded / aria-current。",
    "不要把 __item 放在 __panel 之外的分组里。"
  ],
  "examples": [
    {
      "title": "分组目录（小说阅读器）",
      "html": "<nav class=\"riko-sidenav\" data-riko=\"sidenav\" aria-label=\"小说目录\">\n  <p class=\"riko-sidenav__heading\">小说目录</p>\n  <div class=\"riko-sidenav__group\">\n    <button type=\"button\" class=\"riko-sidenav__group-toggle\" aria-expanded=\"true\">\n      <span class=\"riko-sidenav__badge\">一</span>\n      <span class=\"riko-sidenav__label\"><small>序章</small>第一幕：沙滩上的画家</span>\n      <span class=\"riko-sidenav__count\">3 节</span>\n    </button>\n    <div class=\"riko-sidenav__panel\">\n      <ul class=\"riko-sidenav__list\">\n        <li><a class=\"riko-sidenav__item\" href=\"#001\"><span class=\"riko-sidenav__num\">001</span><span class=\"riko-sidenav__text\">沙滩上的画家</span><span class=\"riko-sidenav__dot\" aria-label=\"已读\"></span></a></li>\n        <li><a class=\"riko-sidenav__item\" href=\"#002\" aria-current=\"page\"><span class=\"riko-sidenav__num\">002</span><span class=\"riko-sidenav__text\">世界的边缘</span><span class=\"riko-sidenav__meta\">3</span></a></li>\n        <li><a class=\"riko-sidenav__item\" href=\"#003\"><span class=\"riko-sidenav__num\">003</span><span class=\"riko-sidenav__text\">熟悉的身影</span></a></li>\n      </ul>\n    </div>\n  </div>\n  <div class=\"riko-sidenav__group\">\n    <button type=\"button\" class=\"riko-sidenav__group-toggle\" aria-expanded=\"false\">\n      <span class=\"riko-sidenav__badge\">二</span>\n      <span class=\"riko-sidenav__label\"><small>序章</small>第二幕：归途的微光</span>\n      <span class=\"riko-sidenav__count\">5 节</span>\n    </button>\n    <div class=\"riko-sidenav__panel\">\n      <ul class=\"riko-sidenav__list\">\n        <li><a class=\"riko-sidenav__item\" href=\"#004\"><span class=\"riko-sidenav__num\">004</span><span class=\"riko-sidenav__text\">变故</span></a></li>\n        <li><a class=\"riko-sidenav__item\" href=\"#005\"><span class=\"riko-sidenav__num\">005</span><span class=\"riko-sidenav__text\">Star 的决心</span></a></li>\n      </ul>\n    </div>\n  </div>\n</nav>"
    },
    {
      "title": "紧凑型",
      "html": "<nav class=\"riko-sidenav riko-sidenav--compact\" data-riko=\"sidenav\" aria-label=\"设定集\">\n  <div class=\"riko-sidenav__group\">\n    <button type=\"button\" class=\"riko-sidenav__group-toggle\" aria-expanded=\"true\">\n      <span class=\"riko-sidenav__badge\"><i data-lucide=\"users\"></i></span>\n      <span class=\"riko-sidenav__label\">人物</span>\n    </button>\n    <div class=\"riko-sidenav__panel\">\n      <ul class=\"riko-sidenav__list\">\n        <li><a class=\"riko-sidenav__item\" href=\"#riko\" aria-current=\"page\">络可</a></li>\n        <li><a class=\"riko-sidenav__item\" href=\"#star\">Star</a></li>\n        <li><a class=\"riko-sidenav__item\" href=\"#111\">111</a></li>\n      </ul>\n    </div>\n  </div>\n</nav>"
    }
  ],
  "requires": [
    {
      "selector": ".riko-sidenav__group",
      "has": ".riko-sidenav__group-toggle",
      "message": "riko-sidenav__group 内需要 riko-sidenav__group-toggle 按钮"
    },
    {
      "selector": ".riko-sidenav__group",
      "has": ".riko-sidenav__panel",
      "message": "riko-sidenav__group 内需要 riko-sidenav__panel"
    },
    {
      "selector": ".riko-sidenav__group-toggle",
      "attr": "aria-expanded",
      "message": "分组按钮需要 aria-expanded"
    },
    {
      "selector": "nav.riko-sidenav",
      "attr": "aria-label|aria-labelledby",
      "message": "<nav class=\"riko-sidenav\"> 需要 aria-label"
    }
  ],
  "related": [
    "toc",
    "navbar",
    "list"
  ]
}
