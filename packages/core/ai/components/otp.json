{
  "name": "otp",
  "title": "验证码输入",
  "titleEn": "OTP Input",
  "category": "form",
  "summary": "分格输入验证码：自动跳格、粘贴拆分、退格回退、短信自动填充，完整值同步到隐藏 input。",
  "when": "短信 / 邮箱验证码、邀请码、PIN。",
  "root": "riko-otp",
  "element": "div",
  "parts": [
    {
      "class": "riko-otp__value",
      "desc": "隐藏 input（name 写在这里，随表单提交）",
      "required": true
    },
    {
      "class": "riko-otp__cell",
      "desc": "单个输入格（JS 生成）"
    },
    {
      "class": "riko-otp__sep",
      "desc": "分隔短线（data-riko-split 时生成）"
    }
  ],
  "modifiers": [
    {
      "class": "riko-otp--sm",
      "desc": "小号",
      "group": "size"
    },
    {
      "class": "riko-otp--lg",
      "desc": "大号",
      "group": "size"
    }
  ],
  "states": [
    {
      "attr": "data-state=\"complete\"",
      "desc": "已填满（JS 维护）"
    },
    {
      "attr": "aria-invalid=\"true\"",
      "desc": "错误状态"
    }
  ],
  "js": {
    "attr": "data-riko=\"otp\"",
    "options": [
      {
        "attr": "data-riko-length",
        "values": "数字",
        "default": "6",
        "desc": "位数"
      },
      {
        "attr": "data-riko-type",
        "values": "numeric | alphanumeric",
        "default": "numeric",
        "desc": "字符类型（字母自动转大写）"
      },
      {
        "attr": "data-riko-split",
        "values": "数字",
        "default": "0",
        "desc": "在第 N 位后加分隔线"
      },
      {
        "attr": "data-riko-required",
        "values": "布尔属性",
        "default": "",
        "desc": "配合 form-validate：必须填满"
      }
    ],
    "methods": [
      {
        "signature": "el.riko.value",
        "desc": "当前值"
      },
      {
        "signature": "el.riko.set(value)",
        "desc": "设置值"
      },
      {
        "signature": "el.riko.clear()",
        "desc": "清空并聚焦第一格"
      },
      {
        "signature": "el.riko.focus()",
        "desc": "聚焦第一个空格"
      }
    ],
    "events": [
      {
        "name": "riko:otp:change",
        "detail": "{ value }",
        "desc": "任一格变化"
      },
      {
        "name": "riko:otp:complete",
        "detail": "{ value }",
        "desc": "全部填满时（适合自动提交）"
      }
    ]
  },
  "a11y": [
    "根元素需要 aria-label 或 aria-labelledby（自动设为 role=group）；每格自动带「第 N 位，共 M 位」。"
  ],
  "rules": [
    "只写一个隐藏的 input.riko-otp__value，输入格交给 JS 生成。",
    "第一格自动带 autocomplete=\"one-time-code\"，手机可直接填入短信验证码。"
  ],
  "avoid": [
    "不要手写 6 个 input。"
  ],
  "examples": [
    {
      "title": "6 位数字",
      "html": "<div class=\"riko-otp\" data-riko=\"otp\" data-riko-length=\"6\" aria-label=\"短信验证码\">\n  <input class=\"riko-otp__value\" type=\"hidden\" name=\"code\">\n</div>"
    },
    {
      "title": "字母数字 · 中间分隔",
      "html": "<div class=\"riko-otp riko-otp--sm\" data-riko=\"otp\" data-riko-length=\"6\" data-riko-split=\"3\" data-riko-type=\"alphanumeric\" aria-label=\"邀请码\">\n  <input class=\"riko-otp__value\" type=\"hidden\" name=\"invite\">\n</div>"
    }
  ],
  "requires": [
    {
      "selector": ".riko-otp",
      "has": ".riko-otp__value",
      "message": "riko-otp 内需要 <input type=\"hidden\" class=\"riko-otp__value\" name=\"…\">"
    },
    {
      "selector": ".riko-otp",
      "attr": "aria-label|aria-labelledby",
      "message": "riko-otp 需要 aria-label 或 aria-labelledby"
    }
  ],
  "related": [
    "form-validate",
    "input"
  ]
}
