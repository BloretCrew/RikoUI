{
  "name": "theme-picker",
  "title": "主题选择器",
  "titleEn": "Theme Picker",
  "category": "general",
  "summary": "让用户在「按系统 / 按时间 / 浅色 / 深色」四种外观模式间切换，选择自动保存。",
  "when": "放在设置弹窗、设置页或页脚。只需要一个浅/深切换按钮时改用 data-riko=\"theme-toggle\"。",
  "root": "riko-theme-picker",
  "element": "div",
  "parts": [
    {
      "class": "riko-theme-picker__option",
      "desc": "选项按钮，必须带 data-theme-mode（自动生成时无需手写）"
    },
    {
      "class": "riko-theme-picker__icon",
      "desc": "选项图标圆圈"
    },
    {
      "class": "riko-theme-picker__text",
      "desc": "文字容器"
    },
    {
      "class": "riko-theme-picker__label",
      "desc": "选项名"
    },
    {
      "class": "riko-theme-picker__desc",
      "desc": "选项说明"
    },
    {
      "class": "riko-theme-toggle",
      "desc": "（theme-toggle 组件自动添加）深浅切换按钮"
    },
    {
      "class": "riko-theme-toggle__sun",
      "desc": "切换按钮中的太阳图标"
    },
    {
      "class": "riko-theme-toggle__moon",
      "desc": "切换按钮中的月亮图标"
    }
  ],
  "modifiers": [
    {
      "class": "riko-theme-picker--compact",
      "desc": "一行四个图标胶囊，适合放在导航栏/页脚",
      "group": "layout"
    }
  ],
  "states": [
    {
      "attr": "aria-pressed=\"true\"",
      "on": "riko-theme-picker__option",
      "desc": "当前选中的模式（JS 自动维护）"
    }
  ],
  "js": {
    "attr": "data-riko=\"theme-picker\"",
    "options": [],
    "methods": [
      {
        "signature": "Riko.theme.set(mode)",
        "desc": "设置模式：'system' | 'time' | 'light' | 'dark'，并保存"
      },
      {
        "signature": "Riko.theme.toggle()",
        "desc": "在浅色与深色间切换"
      },
      {
        "signature": "Riko.theme.mode / Riko.theme.current",
        "desc": "当前模式 / 实际生效的 'light' | 'dark'"
      },
      {
        "signature": "Riko.theme.onChange(fn)",
        "desc": "订阅变化，返回取消函数"
      },
      {
        "signature": "Riko.theme.configure({ storageKey, dayStart, dayEnd })",
        "desc": "自定义存储键与「按时间」的白天范围（默认 8–18 点）"
      }
    ],
    "events": [
      {
        "name": "riko:theme:change",
        "detail": "{ mode, theme }",
        "desc": "在 document 上派发"
      }
    ]
  },
  "a11y": [
    "自动生成时已带 role=\"group\" 与 aria-label，手写选项时也要保留 aria-pressed。",
    "单独的 theme-toggle 若内容为图标，必须有 aria-label（自动生成时默认「切换深浅色」）。"
  ],
  "rules": [
    "留空容器即可，JS 会生成四个选项：<div class=\"riko-theme-picker\" data-riko=\"theme-picker\"></div>。",
    "防闪烁：在 <head>、样式表之前放 <script src=\".../dist/riko-theme-init.js\"></script>（推荐）；服务端渲染时也可把 Riko.themeInitSnippet() 的返回值内联。",
    "深色模式由 <html data-theme=\"dark\"> 控制，不要自己给元素加深色类。"
  ],
  "avoid": [
    "不要自己写 localStorage 主题逻辑或 prefers-color-scheme 媒体查询，统一用 Riko.theme。",
    "不要用 class=\"dark\" / .is-dark 表示深色。"
  ],
  "examples": [
    {
      "title": "完整列表（设置弹窗中）",
      "html": "<div class=\"riko-theme-picker\" data-riko=\"theme-picker\"></div>"
    },
    {
      "title": "紧凑胶囊",
      "html": "<div class=\"riko-theme-picker riko-theme-picker--compact\" data-riko=\"theme-picker\"></div>"
    },
    {
      "title": "深浅切换按钮",
      "html": "<button type=\"button\" class=\"riko-btn riko-btn--icon\" data-riko=\"theme-toggle\" aria-label=\"切换深浅色\"></button>"
    }
  ],
  "requires": [
    {
      "selector": "[data-riko=\"theme-toggle\"]",
      "attr": "aria-label|aria-labelledby",
      "message": "theme-toggle 按钮需要 aria-label"
    }
  ],
  "related": [
    "dialog",
    "button"
  ]
}