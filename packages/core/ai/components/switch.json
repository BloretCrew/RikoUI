{
  "name": "switch",
  "title": "开关",
  "titleEn": "Switch",
  "category": "form",
  "summary": "立即生效的开/关设置，打开时圆钮里出现一颗小星星。",
  "when": "设置项「打开/关闭」且立即生效。需要提交表单才生效的勾选用 checkbox。",
  "root": "riko-switch",
  "element": "label",
  "parts": [
    {
      "class": "riko-switch__text",
      "desc": "标题 + 说明的文字容器"
    },
    {
      "class": "riko-switch__desc",
      "desc": "说明小字"
    }
  ],
  "modifiers": [
    {
      "class": "riko-switch--sm",
      "desc": "小号",
      "group": "size"
    },
    {
      "class": "riko-switch--lg",
      "desc": "大号",
      "group": "size"
    },
    {
      "class": "riko-switch--end",
      "desc": "文字在左、开关在右，占满一行（设置列表）",
      "group": "layout"
    }
  ],
  "states": [
    {
      "attr": "checked",
      "on": "input",
      "desc": "打开"
    },
    {
      "attr": "disabled",
      "on": "input",
      "desc": "禁用"
    }
  ],
  "js": null,
  "a11y": [
    "input 写 role=\"switch\"，读屏会读作「开关，开/关」。"
  ],
  "rules": [
    "结构：<label class=\"riko-switch\"><input type=\"checkbox\" role=\"switch\"> 文字</label>。"
  ],
  "avoid": [
    "不要用按钮 + 类名模拟开关。"
  ],
  "examples": [
    {
      "title": "基础",
      "html": "<div class=\"riko-stack riko-stack--sm\">\n  <label class=\"riko-switch\"><input type=\"checkbox\" role=\"switch\" checked> 新章节提醒</label>\n  <label class=\"riko-switch\"><input type=\"checkbox\" role=\"switch\"> 夜间护眼</label>\n  <label class=\"riko-switch\"><input type=\"checkbox\" role=\"switch\" disabled> 自动翻页（即将推出）</label>\n</div>"
    },
    {
      "title": "尺寸",
      "html": "<div class=\"riko-cluster riko-cluster--lg\">\n  <label class=\"riko-switch riko-switch--sm\"><input type=\"checkbox\" role=\"switch\" checked> 小号</label>\n  <label class=\"riko-switch\"><input type=\"checkbox\" role=\"switch\" checked> 默认</label>\n  <label class=\"riko-switch riko-switch--lg\"><input type=\"checkbox\" role=\"switch\" checked> 大号</label>\n</div>"
    },
    {
      "title": "设置列表",
      "html": "<div class=\"riko-stack\">\n  <label class=\"riko-switch riko-switch--end\"><input type=\"checkbox\" role=\"switch\" checked><span class=\"riko-switch__text\">漂浮星星<span class=\"riko-switch__desc\">在页面背景中显示闪烁的小星星</span></span></label>\n  <label class=\"riko-switch riko-switch--end\"><input type=\"checkbox\" role=\"switch\"><span class=\"riko-switch__text\">减少动画<span class=\"riko-switch__desc\">关闭回弹与淡入效果</span></span></label>\n</div>"
    }
  ],
  "requires": [
    {
      "selector": ".riko-switch",
      "has": "input[type=\"checkbox\"]",
      "message": "riko-switch 内需要直接放 <input type=\"checkbox\" role=\"switch\">"
    },
    {
      "selector": ".riko-switch input[type=\"checkbox\"]",
      "attr": "role",
      "message": "开关的 input 需要 role=\"switch\""
    }
  ],
  "related": [
    "checkbox"
  ]
}
