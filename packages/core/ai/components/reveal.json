{
  "name": "reveal",
  "title": "滚动进场",
  "titleEn": "Reveal",
  "category": "foundation",
  "summary": "元素滚动进入视口时淡入上移。",
  "when": "首页版块、卡片网格的进场点缀；不要用于首屏关键内容。",
  "root": null,
  "js": {
    "attr": "data-riko=\"reveal\"",
    "options": [
      {
        "attr": "data-riko-delay",
        "values": "毫秒",
        "default": "0",
        "desc": "进场延迟（可做错落效果）"
      }
    ],
    "methods": [],
    "events": []
  },
  "a11y": [
    "用户开启「减少动态效果」时直接显示，无动画。"
  ],
  "rules": [
    "无 JS 时内容正常显示（渐进增强）。"
  ],
  "examples": [
    {
      "title": "基础",
      "html": "<section class=\"riko-section\" data-riko=\"reveal\">…</section>"
    }
  ],
  "parts": [
    {
      "class": "riko-u-reveal",
      "desc": "由 JS 自动添加的进场过渡类（无需手写）"
    }
  ]
}