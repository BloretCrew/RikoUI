{
  "name": "link",
  "title": "链接",
  "titleEn": "Link",
  "category": "general",
  "summary": "带波浪下划线的文字链接，适合正文中跳转。",
  "when": "正文或说明文字中的跳转。需要按钮外观时用 <a class=\"riko-btn\">。未加类的 <a> 也会得到同样的基础样式。",
  "root": "riko-link",
  "element": "a",
  "modifiers": [
    {
      "class": "riko-link--muted",
      "desc": "低调灰棕色",
      "group": "variant"
    },
    {
      "class": "riko-link--plain",
      "desc": "无下划线，悬停才出现",
      "group": "variant"
    },
    {
      "class": "riko-link--external",
      "desc": "外链：末尾自动加外链图标",
      "group": "decor"
    }
  ],
  "states": [
    {
      "attr": "aria-current=\"page\"",
      "desc": "当前页面"
    },
    {
      "attr": "aria-disabled=\"true\"",
      "desc": "不可用（同时去掉 href）"
    }
  ],
  "js": null,
  "a11y": [
    "链接文字要能独立说明去向，不要只写「点这里」。",
    "外链加 target=\"_blank\" 时同时写 rel=\"noopener\"。"
  ],
  "rules": [
    "外链写法：<a class=\"riko-link riko-link--external\" href=\"…\" target=\"_blank\" rel=\"noopener\">。"
  ],
  "avoid": [
    "不要用链接触发 JS 操作（那是按钮的工作）。"
  ],
  "examples": [
    {
      "title": "基础",
      "html": "<p>跟随络可，<a class=\"riko-link\" href=\"#link\">从沙滩上的第一幅画</a>开始读起吧。</p>"
    },
    {
      "title": "变体",
      "html": "<div class=\"riko-cluster riko-cluster--lg\">\n  <a class=\"riko-link riko-link--muted\" href=\"#link\">低调链接</a>\n  <a class=\"riko-link riko-link--plain\" href=\"#link\">悬停才有下划线</a>\n  <a class=\"riko-link riko-link--external\" href=\"https://riko.land\" target=\"_blank\" rel=\"noopener\">络的世界官网</a>\n  <a class=\"riko-link\" aria-current=\"page\" href=\"#link\">当前页面</a>\n  <a class=\"riko-link\" aria-disabled=\"true\">暂不可用</a>\n</div>"
    }
  ],
  "requires": [
    {
      "selector": "a.riko-link--external",
      "attr": "rel",
      "message": "外链需要 rel=\"noopener\""
    }
  ],
  "related": [
    "button"
  ]
}
