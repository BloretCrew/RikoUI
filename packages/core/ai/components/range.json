{
  "name": "range",
  "title": "滑块",
  "titleEn": "Range",
  "category": "form",
  "summary": "美化的原生滑块：已选段为暖橙色，可同步显示数值。",
  "when": "在连续区间内调节数值（音量、字号、亮度）。需要精确数字时配合 number 输入。",
  "root": "riko-range",
  "element": "input",
  "parts": [
    {
      "class": "riko-output",
      "desc": "数值显示徽章：独立的 <output class=\"riko-output\" for=\"滑块 id\">（不放在 input 内）"
    }
  ],
  "modifiers": [
    {
      "class": "riko-range--sm",
      "desc": "细轨道小圆钮",
      "group": "size"
    },
    {
      "class": "riko-range--ice",
      "desc": "冰蓝色",
      "group": "variant"
    }
  ],
  "states": [
    {
      "attr": "disabled",
      "desc": "禁用"
    }
  ],
  "js": {
    "attr": "data-riko=\"range\"",
    "options": [
      {
        "attr": "data-riko-output",
        "values": "CSS 选择器",
        "default": "output[for=该 id]",
        "desc": "额外要同步显示值的元素"
      },
      {
        "attr": "data-riko-suffix",
        "values": "文本",
        "default": "无",
        "desc": "显示值的后缀，如 px、%"
      }
    ],
    "methods": [
      {
        "signature": "el.riko.update()",
        "desc": "用 JS 改 value 后刷新填充与显示"
      }
    ],
    "events": []
  },
  "a11y": [
    "必须有 label 或 aria-label。"
  ],
  "rules": [
    "建议总是加 data-riko=\"range\"，否则 Chrome/Safari 中已选段不会着色（Firefox 原生支持）。"
  ],
  "avoid": [
    "不要用 div 模拟滑块。"
  ],
  "examples": [
    {
      "title": "基础",
      "html": "<input class=\"riko-range\" type=\"range\" min=\"0\" max=\"100\" value=\"40\" data-riko=\"range\" aria-label=\"背景音乐音量\">"
    },
    {
      "title": "显示数值",
      "html": "<div class=\"riko-field\">\n  <div class=\"riko-cluster riko-cluster--between\">\n    <label class=\"riko-field__label\" for=\"font-size\">正文字号</label>\n    <output class=\"riko-output\" for=\"font-size\">18px</output>\n  </div>\n  <input class=\"riko-range\" id=\"font-size\" type=\"range\" min=\"14\" max=\"26\" value=\"18\" data-riko=\"range\" data-riko-suffix=\"px\">\n</div>"
    },
    {
      "title": "小号与冰蓝",
      "html": "<div class=\"riko-stack\">\n  <input class=\"riko-range riko-range--sm\" type=\"range\" value=\"70\" data-riko=\"range\" aria-label=\"亮度\">\n  <input class=\"riko-range riko-range--ice\" type=\"range\" value=\"25\" data-riko=\"range\" aria-label=\"海浪声\">\n  <input class=\"riko-range\" type=\"range\" value=\"50\" disabled data-riko=\"range\" aria-label=\"不可调节\">\n</div>"
    }
  ],
  "requires": [
    {
      "selector": "input.riko-range:not([id]):not([aria-label]):not([aria-labelledby])",
      "parent": "label",
      "message": "riko-range 需要 label 或 aria-label"
    },
    {
      "selector": ".riko-range",
      "message": "riko-range 必须加在 <input type=\"range\"> 上",
      "tag": "input"
    }
  ],
  "related": [
    "field",
    "input"
  ]
}