  "rules": [
    "间距工具只有 mt/mb 的 0/2/4/6/8/10 档（对应 --riko-space-*）；更复杂的间距请用 riko-stack / riko-cluster。"
  ],
  "avoid": [
    "不要用工具类堆砌组件外观（颜色、阴影、圆角），那是组件的职责。"
  ],
