  "js": {
    "attr": "",
    "options": [],
    "methods": [
      {
        "signature": "Riko.init(root)",
        "desc": "页面已加载 lucide 时，会自动把 root 内的 <i data-lucide> 渲染为 svg"
      }
    ],
    "events": []
  },
  "a11y": [
    "纯装饰图标加 aria-hidden=\"true\"；有含义的独立图标加 role=\"img\" 与 aria-label。",
    "仅含图标的按钮要在按钮上写 aria-label。"
  ],
  "rules": [
    "Lucide：<i data-lucide=\"heart\"></i>，先引入 lucide 再引入 riko-ui.js，Riko 会自动渲染。",
    "内置图标：<span class=\"riko-icon riko-icon--search\" aria-hidden=\"true\"></span>。",
    "图标颜色继承 currentColor，尺寸默认 1.15em，可用 --riko-icon-size 覆盖。",
    "星星颜色可用 --riko-star-color 覆盖，尺寸用 --riko-star-size。"
  ],
  "avoid": [
    "不要混用多个图标库，统一 Lucide。",
    "不要写 <span class=\"riko-icon--check\">（缺少根类 riko-icon）。"
  ],
  "examples": [
    {
      "title": "Lucide 图标",
      "html": "<i data-lucide=\"book-open\"></i>"
    },
    {
      "title": "内置图标",
      "html": "<span class=\"riko-icon riko-icon--search\" aria-hidden=\"true\"></span>"
    },
    {
      "title": "品牌星星",
      "html": "<span class=\"riko-star riko-star--lg riko-star--twinkle\" aria-hidden=\"true\"></span>"
    }
  ],
  "requires": [
    {
      "selector": ".riko-star:not([aria-hidden]):not([role])",
      "attr": "aria-hidden|aria-label",
      "message": "装饰星星请加 aria-hidden=\"true\"（或提供 role=\"img\" + aria-label）"
    }
  ],
  "related": [
    "button",
    "typography"
  ]
}