{
  "name": "tree",
  "title": "树形列表",
  "titleEn": "Tree",
  "category": "data",
  "summary": "用嵌套 <details> 构建的文件夹树，虚线连接层级，原生键盘可用。",
  "when": "层级目录（文件、设定分类、章节结构）。只有一层分组时用 accordion。",
  "root": "riko-tree",
  "element": "ul",
  "parts": [
    {
      "class": "riko-tree__folder",
      "desc": "文件夹（<details>）"
    },
    {
      "class": "riko-tree__label",
      "desc": "文件夹名（<summary>）"
    },
    {
      "class": "riko-tree__group",
      "desc": "子级列表（<ul>）"
    },
    {
      "class": "riko-tree__file",
      "desc": "叶子节点（<a> 或 <button>）"
    },
    {
      "class": "riko-tree__meta",
      "desc": "右侧附注（如数量）"
    }
  ],
  "states": [
    {
      "attr": "open",
      "on": "riko-tree__folder",
      "desc": "原生属性：默认展开"
    },
    {
      "attr": "aria-current=\"page\"",
      "on": "riko-tree__file",
      "desc": "当前项"
    }
  ],
  "js": null,
  "a11y": [
    "文件夹使用 <details>/<summary>，可用 Tab + Enter/空格展开。",
    "叶子节点用真正的链接或按钮。"
  ],
  "rules": [
    "图标自动显示（文件夹开/合、文件），不需要手写。"
  ],
  "avoid": [
    "不要用 div 嵌套模拟树。"
  ],
  "examples": [
    {
      "title": "文件夹树",
      "html": "<ul class=\"riko-tree\" style=\"max-width: 360px\">\n  <li>\n    <details class=\"riko-tree__folder\" open>\n      <summary class=\"riko-tree__label\">络可的笔记本 <span class=\"riko-tree__meta\">4</span></summary>\n      <ul class=\"riko-tree__group\">\n        <li>\n          <details class=\"riko-tree__folder\" open>\n            <summary class=\"riko-tree__label\">人物</summary>\n            <ul class=\"riko-tree__group\">\n              <li><a class=\"riko-tree__file\" href=\"#tree\" aria-current=\"page\">络可.md</a></li>\n              <li><a class=\"riko-tree__file\" href=\"#tree\">Star.md</a></li>\n            </ul>\n          </details>\n        </li>\n        <li>\n          <details class=\"riko-tree__folder\">\n            <summary class=\"riko-tree__label\">地点</summary>\n            <ul class=\"riko-tree__group\">\n              <li><a class=\"riko-tree__file\" href=\"#tree\">HV 村庄.md</a></li>\n              <li><a class=\"riko-tree__file\" href=\"#tree\">边界之地.md</a></li>\n            </ul>\n          </details>\n        </li>\n      </ul>\n    </details>\n  </li>\n</ul>"
    }
  ],
  "requires": [
    {
      "selector": ".riko-tree__folder",
      "message": "riko-tree__folder 必须是 <details>",
      "tag": "details"
    },
    {
      "selector": ".riko-tree__label",
      "message": "riko-tree__label 必须是 <summary>",
      "tag": "summary"
    },
    {
      "selector": ".riko-tree__file,.riko-tree__folder",
      "parent": ".riko-tree",
      "message": "tree 的部件必须位于 riko-tree 之内"
    }
  ],
  "related": [
    "accordion",
    "sidenav"
  ]
}