{
  "name": "table",
  "title": "表格",
  "titleEn": "Table",
  "category": "data",
  "summary": "手绘风数据表格，外层负责横向滚动与圆角，支持斑马纹、悬停、紧凑、竖线与点击表头排序。",
  "when": "需要按列对比的结构化数据。只有一列信息时用 list。",
  "root": "riko-table",
  "element": "table",
  "parts": [
    {
      "class": "riko-table-wrap",
      "desc": "外层容器（必需）：圆角边框、窄屏横向滚动"
    },
    {
      "class": "riko-table__sort",
      "desc": "排序按钮（由 table-sort 自动生成）"
    }
  ],
  "modifiers": [
    {
      "class": "riko-table--striped",
      "desc": "斑马纹",
      "group": "decor"
    },
    {
      "class": "riko-table--hover",
      "desc": "悬停行高亮",
      "group": "behavior"
    },
    {
      "class": "riko-table--compact",
      "desc": "紧凑",
      "group": "size"
    },
    {
      "class": "riko-table--bordered",
      "desc": "列之间虚线",
      "group": "decor"
    },
    {
      "class": "riko-table-wrap--sticky",
      "desc": "（加在 wrap 上）限制高度、表头吸顶；高度用 --riko-table-max-h",
      "group": "layout"
    }
  ],
  "states": [
    {
      "attr": "aria-sort=\"ascending|descending\"",
      "on": "th",
      "desc": "当前排序列（table-sort 自动维护）"
    },
    {
      "attr": "aria-selected=\"true\"",
      "on": "tr",
      "desc": "选中行高亮"
    },
    {
      "attr": "data-align=\"end|center\"",
      "on": "th / td",
      "desc": "单元格对齐（数字列建议 end）"
    }
  ],
  "js": {
    "attr": "data-riko=\"table-sort\"",
    "options": [
      {
        "attr": "data-riko-sort=\"false\"",
        "values": "false",
        "desc": "写在 th 上：该列不可排序"
      },
      {
        "attr": "data-riko-value",
        "values": "任意",
        "desc": "写在 td 上：用于排序的值（如日期时间戳）"
      }
    ],
    "methods": [
      {
        "signature": "table.riko.sort(column, direction)",
        "desc": "按列（序号或 th 元素）排序，direction 为 ascending / descending"
      }
    ],
    "events": [
      {
        "name": "riko:table:sort",
        "detail": "{ column, direction }",
        "desc": "排序后触发"
      }
    ]
  },
  "a11y": [
    "表头用 <th scope=\"col\">，行标题用 <th scope=\"row\">。",
    "用 <caption> 说明表格内容。",
    "排序状态通过 aria-sort 提供给读屏，无需额外文字。"
  ],
  "rules": [
    "始终包一层 <div class=\"riko-table-wrap\">。",
    "数字列加 data-align=\"end\"，数字自动等宽对齐。"
  ],
  "avoid": [
    "不要用表格做页面布局。",
    "不要给 th 自己加排序图标，table-sort 会自动生成。"
  ],
  "examples": [
    {
      "title": "可排序表格",
      "html": "<div class=\"riko-table-wrap\">\n  <table class=\"riko-table riko-table--striped riko-table--hover\" data-riko=\"table-sort\">\n    <caption>HV 骨干成员</caption>\n    <thead>\n      <tr><th scope=\"col\">成员</th><th scope=\"col\">职责</th><th scope=\"col\" data-align=\"end\">登场小节</th><th scope=\"col\" data-riko-sort=\"false\">状态</th></tr>\n    </thead>\n    <tbody>\n      <tr><th scope=\"row\">络可</th><td>画家</td><td data-align=\"end\">1</td><td><span class=\"riko-tag riko-tag--sm riko-tag--success\">在村中</span></td></tr>\n      <tr><th scope=\"row\">Star</th><td>工建 · 战斗</td><td data-align=\"end\">2</td><td><span class=\"riko-tag riko-tag--sm riko-tag--warning\">养伤中</span></td></tr>\n      <tr><th scope=\"row\">111</th><td>村长</td><td data-align=\"end\">4</td><td><span class=\"riko-tag riko-tag--sm riko-tag--success\">在村中</span></td></tr>\n      <tr><th scope=\"row\">无昵</th><td>交易场所</td><td data-align=\"end\">29</td><td><span class=\"riko-tag riko-tag--sm riko-tag--ice\">外出</span></td></tr>\n    </tbody>\n  </table>\n</div>"
    },
    {
      "title": "紧凑与竖线",
      "html": "<div class=\"riko-table-wrap\">\n  <table class=\"riko-table riko-table--compact riko-table--bordered\">\n    <thead>\n      <tr><th scope=\"col\">幕</th><th scope=\"col\">标题</th><th scope=\"col\" data-align=\"end\">小节数</th></tr>\n    </thead>\n    <tbody>\n      <tr><td>序章 · 第一幕</td><td>沙滩上的画家</td><td data-align=\"end\">3</td></tr>\n      <tr><td>序章 · 第二幕</td><td>归途的微光</td><td data-align=\"end\">5</td></tr>\n      <tr><td>第一章 · 第五幕</td><td>落星摇曳，清风回荡</td><td data-align=\"end\">17</td></tr>\n    </tbody>\n    <tfoot>\n      <tr><td colspan=\"2\">合计</td><td data-align=\"end\">25</td></tr>\n    </tfoot>\n  </table>\n</div>"
    }
  ],
  "requires": [
    {
      "selector": "table.riko-table",
      "parent": ".riko-table-wrap",
      "message": "riko-table 需要包在 <div class=\"riko-table-wrap\"> 中"
    },
    {
      "selector": "[data-riko=\"table-sort\"]",
      "has": "thead",
      "message": "可排序表格需要 <thead>"
    }
  ],
  "related": [
    "list",
    "desc-list"
  ]
}
