{
  "name": "button",
  "title": "按钮",
  "titleEn": "Button",
  "category": "general",
  "summary": "触发操作的按钮：纸白描边 + 底部实体阴影，悬停上浮、按下下沉。",
  "when": "用于提交、打开弹窗、执行操作等。跳转页面时用 <a class=\"riko-btn\" href>；只是行内文字链接改用 riko-link。",
  "root": "riko-btn",
  "element": "button",
  "parts": [
    {
      "class": "riko-btn__badge",
      "desc": "按钮内的计数徽章"
    }
  ],
  "modifiers": [
    {
      "class": "riko-btn--primary",
      "desc": "主要操作：可可色实心（每个区域最多一个）",
      "group": "variant"
    },
    {
      "class": "riko-btn--accent",
      "desc": "强调：暖橙色实心",
      "group": "variant"
    },
    {
      "class": "riko-btn--ice",
      "desc": "冰蓝色",
      "group": "variant"
    },
    {
      "class": "riko-btn--soft",
      "desc": "浅橙底，无描边",
      "group": "variant"
    },
    {
      "class": "riko-btn--outline",
      "desc": "虚线描边，透明底",
      "group": "variant"
    },
    {
      "class": "riko-btn--ghost",
      "desc": "无边框，悬停出现浅底（工具栏、次要操作）",
      "group": "variant"
    },
    {
      "class": "riko-btn--link",
      "desc": "像链接一样的按钮",
      "group": "variant"
    },
    {
      "class": "riko-btn--danger",
      "desc": "危险操作（删除等）",
      "group": "variant"
    },
    {
      "class": "riko-btn--xs",
      "desc": "超小 28px",
      "group": "size"
    },
    {
      "class": "riko-btn--sm",
      "desc": "小号 34px",
      "group": "size"
    },
    {
      "class": "riko-btn--lg",
      "desc": "大号 52px",
      "group": "size"
    },
    {
      "class": "riko-btn--xl",
      "desc": "超大 60px",
      "group": "size"
    },
    {
      "class": "riko-btn--icon",
      "desc": "仅图标的正圆角方形按钮（必须有 aria-label）",
      "group": "shape"
    },
    {
      "class": "riko-btn--round",
      "desc": "正圆按钮（仅图标，必须有 aria-label）",
      "group": "shape"
    },
    {
      "class": "riko-btn--square",
      "desc": "手绘不规则圆角",
      "group": "shape"
    },
    {
      "class": "riko-btn--block",
      "desc": "占满父容器宽度",
      "group": "layout"
    }
  ],
  "states": [
    {
      "attr": "disabled",
      "desc": "<button> 禁用"
    },
    {
      "attr": "aria-disabled=\"true\"",
      "desc": "<a> 链接按钮禁用（同时去掉 href）"
    },
    {
      "attr": "aria-busy=\"true\"",
      "desc": "加载中：显示旋转图标并阻止点击"
    },
    {
      "attr": "aria-pressed=\"true\"",
      "desc": "切换按钮的按下状态"
    }
  ],
  "js": null,
  "a11y": [
    "<button> 必须写 type（button / submit / reset）。",
    "仅图标按钮（--icon / --round）必须有 aria-label。",
    "切换型按钮用 aria-pressed 表示状态，不要用类名。"
  ],
  "rules": [
    "图标直接放在按钮里：<i data-lucide=\"名称\"></i>，间距自动处理；图标放在文字后面时悬停会轻轻右移。",
    "一个区域只放一个 --primary 按钮，其余用默认或 --ghost。",
    "外观、尺寸、形状三组修饰各选一个即可自由组合。"
  ],
  "avoid": [
    "不要用 <div onclick> 代替按钮。",
    "不要给按钮写内联颜色，用外观修饰或覆盖 --riko-btn-bg 等私有变量。",
    "不要同时写两个外观修饰（如 --primary 和 --ghost）。"
  ],
  "examples": [
    {
      "title": "外观",
      "html": "<div class=\"riko-cluster\">\n  <button type=\"button\" class=\"riko-btn\">默认按钮</button>\n  <button type=\"button\" class=\"riko-btn riko-btn--primary\">开始阅读</button>\n  <button type=\"button\" class=\"riko-btn riko-btn--accent\">点亮星星</button>\n  <button type=\"button\" class=\"riko-btn riko-btn--ice\">冰蓝色</button>\n  <button type=\"button\" class=\"riko-btn riko-btn--soft\">柔和</button>\n  <button type=\"button\" class=\"riko-btn riko-btn--outline\">虚线描边</button>\n  <button type=\"button\" class=\"riko-btn riko-btn--ghost\">幽灵</button>\n  <button type=\"button\" class=\"riko-btn riko-btn--link\">文字链接</button>\n  <button type=\"button\" class=\"riko-btn riko-btn--danger\">删除画稿</button>\n</div>"
    },
    {
      "title": "带图标",
      "html": "<div class=\"riko-cluster\">\n  <button type=\"button\" class=\"riko-btn riko-btn--primary\"><i data-lucide=\"book-open\"></i>开始阅读</button>\n  <a class=\"riko-btn\" href=\"#button\">下一节<i data-lucide=\"arrow-right\"></i></a>\n  <button type=\"button\" class=\"riko-btn riko-btn--soft\"><span class=\"riko-star\" aria-hidden=\"true\"></span>收藏</button>\n  <button type=\"button\" class=\"riko-btn\">消息<span class=\"riko-btn__badge\">3</span></button>\n</div>"
    },
    {
      "title": "尺寸",
      "html": "<div class=\"riko-cluster\">\n  <button type=\"button\" class=\"riko-btn riko-btn--xs\">超小</button>\n  <button type=\"button\" class=\"riko-btn riko-btn--sm\">小号</button>\n  <button type=\"button\" class=\"riko-btn\">默认</button>\n  <button type=\"button\" class=\"riko-btn riko-btn--lg\">大号</button>\n  <button type=\"button\" class=\"riko-btn riko-btn--xl\">超大</button>\n</div>"
    },
    {
      "title": "仅图标与形状",
      "html": "<div class=\"riko-cluster\">\n  <button type=\"button\" class=\"riko-btn riko-btn--icon\" aria-label=\"设置\"><i data-lucide=\"settings\"></i></button>\n  <button type=\"button\" class=\"riko-btn riko-btn--icon riko-btn--ice\" aria-label=\"搜索\"><i data-lucide=\"search\"></i></button>\n  <button type=\"button\" class=\"riko-btn riko-btn--round riko-btn--accent\" aria-label=\"点赞\"><i data-lucide=\"heart\"></i></button>\n  <button type=\"button\" class=\"riko-btn riko-btn--square riko-btn--soft\">方角按钮</button>\n  <button type=\"button\" class=\"riko-btn riko-btn--ghost riko-btn--icon riko-btn--sm\" aria-label=\"更多\"><i data-lucide=\"ellipsis\"></i></button>\n</div>"
    },
    {
      "title": "状态",
      "html": "<div class=\"riko-cluster\">\n  <button type=\"button\" class=\"riko-btn\" disabled>不可用</button>\n  <button type=\"button\" class=\"riko-btn riko-btn--primary\" aria-busy=\"true\">保存中</button>\n  <button type=\"button\" class=\"riko-btn\" aria-pressed=\"true\"><i data-lucide=\"bookmark\"></i>已加书签</button>\n  <a class=\"riko-btn riko-btn--outline\" aria-disabled=\"true\">链接不可用</a>\n</div>"
    },
    {
      "title": "占满宽度",
      "html": "<button type=\"button\" class=\"riko-btn riko-btn--primary riko-btn--lg riko-btn--block\"><i data-lucide=\"sparkles\"></i>踏入络的世界</button>"
    }
  ],
  "requires": [
    {
      "selector": "button.riko-btn",
      "attr": "type",
      "message": "<button class=\"riko-btn\"> 需要写 type 属性（button / submit / reset）"
    },
    {
      "selector": ".riko-btn--icon, .riko-btn--round",
      "attr": "aria-label|aria-labelledby|title",
      "message": "仅图标按钮需要 aria-label"
    },
    {
      "selector": ".riko-btn__badge",
      "parent": ".riko-btn",
      "message": "riko-btn__badge 必须放在 .riko-btn 内"
    }
  ],
  "related": [
    "button-group",
    "link",
    "theme-picker"
  ]
}