{
  "name": "swatches",
  "title": "色块选择",
  "titleEn": "Swatches",
  "category": "form",
  "summary": "基于单选框的圆形色块选择，选中时显示勾与描边。",
  "when": "选择主题色、标签颜色、画笔颜色等少量预设颜色。任意颜色用 <input class=\"riko-input\" type=\"color\">。",
  "root": "riko-swatches",
  "element": "div",
  "parts": [
    {
      "class": "riko-swatches__item",
      "desc": "<label>，用 style=\"--riko-swatch: …\" 指定颜色",
      "required": true
    },
    {
      "class": "riko-swatches__input",
      "desc": "<input type=\"radio\">（视觉隐藏）",
      "required": true
    },
    {
      "class": "riko-swatches__color",
      "desc": "色块",
      "required": true
    },
    {
      "class": "riko-swatches__label",
      "desc": "颜色名（可加 riko-u-sr-only 只给读屏）"
    }
  ],
  "modifiers": [
    {
      "class": "riko-swatches--sm",
      "desc": "小号",
      "group": "size"
    },
    {
      "class": "riko-swatches--lg",
      "desc": "大号",
      "group": "size"
    },
    {
      "class": "riko-swatches--square",
      "desc": "手绘圆角方块",
      "group": "shape"
    }
  ],
  "states": [
    {
      "attr": "checked",
      "on": "riko-swatches__input",
      "desc": "选中"
    },
    {
      "attr": "disabled",
      "on": "riko-swatches__input",
      "desc": "不可选"
    }
  ],
  "js": null,
  "a11y": [
    "根元素写 role=\"radiogroup\" 与 aria-label；每个色块都要有颜色名（可视或 riko-u-sr-only）。"
  ],
  "rules": [
    "颜色优先用设计变量，例如 style=\"--riko-swatch: var(--riko-color-ice-strong)\"。",
    "结构顺序：input → color → label（勾选样式依赖相邻关系）。"
  ],
  "avoid": [
    "不要只靠颜色区分而不提供名称。"
  ],
  "examples": [
    {
      "title": "基础用法",
      "html": "<div class=\"riko-swatches\" role=\"radiogroup\" aria-label=\"主题色\">\n  <label class=\"riko-swatches__item\" style=\"--riko-swatch: var(--riko-color-accent)\">\n    <input class=\"riko-swatches__input\" type=\"radio\" name=\"color\" value=\"star\" checked>\n    <span class=\"riko-swatches__color\"></span>\n    <span class=\"riko-swatches__label\">星星橙</span>\n  </label>\n  <label class=\"riko-swatches__item\" style=\"--riko-swatch: var(--riko-color-ice-strong)\">\n    <input class=\"riko-swatches__input\" type=\"radio\" name=\"color\" value=\"ice\">\n    <span class=\"riko-swatches__color\"></span>\n    <span class=\"riko-swatches__label\">冰蓝</span>\n  </label>\n  <label class=\"riko-swatches__item\" style=\"--riko-swatch: var(--riko-color-primary)\">\n    <input class=\"riko-swatches__input\" type=\"radio\" name=\"color\" value=\"cocoa\">\n    <span class=\"riko-swatches__color\"></span>\n    <span class=\"riko-swatches__label\">可可</span>\n  </label>\n  <label class=\"riko-swatches__item\" style=\"--riko-swatch: var(--riko-color-success)\">\n    <input class=\"riko-swatches__input\" type=\"radio\" name=\"color\" value=\"leaf\">\n    <span class=\"riko-swatches__color\"></span>\n    <span class=\"riko-swatches__label\">嫩叶</span>\n  </label>\n  <label class=\"riko-swatches__item\" style=\"--riko-swatch: var(--riko-color-danger)\">\n    <input class=\"riko-swatches__input\" type=\"radio\" name=\"color\" value=\"berry\">\n    <span class=\"riko-swatches__color\"></span>\n    <span class=\"riko-swatches__label\">莓果</span>\n  </label>\n</div>"
    },
    {
      "title": "小号方形（仅色块）",
      "html": "<div class=\"riko-swatches riko-swatches--sm riko-swatches--square\" role=\"radiogroup\" aria-label=\"画笔颜色\">\n  <label class=\"riko-swatches__item\" style=\"--riko-swatch: var(--riko-color-tan)\">\n    <input class=\"riko-swatches__input\" type=\"radio\" name=\"brush\" value=\"sand\" checked>\n    <span class=\"riko-swatches__color\"></span>\n    <span class=\"riko-swatches__label riko-u-sr-only\">沙滩</span>\n  </label>\n  <label class=\"riko-swatches__item\" style=\"--riko-swatch: var(--riko-color-ice)\">\n    <input class=\"riko-swatches__input\" type=\"radio\" name=\"brush\" value=\"sea\">\n    <span class=\"riko-swatches__color\"></span>\n    <span class=\"riko-swatches__label riko-u-sr-only\">海水</span>\n  </label>\n  <label class=\"riko-swatches__item\" style=\"--riko-swatch: var(--riko-color-warning)\">\n    <input class=\"riko-swatches__input\" type=\"radio\" name=\"brush\" value=\"sun\">\n    <span class=\"riko-swatches__color\"></span>\n    <span class=\"riko-swatches__label riko-u-sr-only\">阳光</span>\n  </label>\n  <label class=\"riko-swatches__item\" style=\"--riko-swatch: var(--riko-color-brown)\">\n    <input class=\"riko-swatches__input\" type=\"radio\" name=\"brush\" value=\"wood\">\n    <span class=\"riko-swatches__color\"></span>\n    <span class=\"riko-swatches__label riko-u-sr-only\">木头</span>\n  </label>\n</div>"
    }
  ],
  "requires": [
    {
      "selector": ".riko-swatches__item",
      "tag": "label",
      "message": "riko-swatches__item 必须是 <label>（点击色块即可选中）"
    },
    {
      "selector": ".riko-swatches__item",
      "has": ".riko-swatches__input",
      "message": "riko-swatches__item 内需要 input.riko-swatches__input"
    },
    {
      "selector": ".riko-swatches",
      "attr": "aria-label|aria-labelledby",
      "message": "riko-swatches 需要 role=\"radiogroup\" 与 aria-label"
    }
  ],
  "related": [
    "radio",
    "segmented"
  ]
}
