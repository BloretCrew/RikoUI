{
  "name": "banner",
  "title": "公告横幅",
  "titleEn": "Banner",
  "category": "feedback",
  "summary": "横跨页面或内容区顶部的一条公告，可带图标、链接与关闭按钮，可吸顶。",
  "when": "全站公告、更新通知、维护提醒。内容中的普通提示用 alert；临时反馈用 toast。",
  "root": "riko-banner",
  "element": "div",
  "parts": [
    {
      "class": "riko-banner__icon",
      "desc": "图标：可直接写 riko-banner__icon riko-star（闪烁星星），或放 Lucide 图标"
    },
    {
      "class": "riko-banner__text",
      "desc": "公告文字（<p>）",
      "required": true
    },
    {
      "class": "riko-banner__link",
      "desc": "文字中的链接（波浪下划线）"
    },
    {
      "class": "riko-banner__close",
      "desc": "关闭按钮：空 <button>，带 data-riko-dismiss 与 aria-label"
    }
  ],
  "modifiers": [
    {
      "class": "riko-banner--ice",
      "desc": "冰蓝",
      "group": "tone"
    },
    {
      "class": "riko-banner--success",
      "desc": "成功",
      "group": "tone"
    },
    {
      "class": "riko-banner--warning",
      "desc": "警告",
      "group": "tone"
    },
    {
      "class": "riko-banner--danger",
      "desc": "危险",
      "group": "tone"
    },
    {
      "class": "riko-banner--sticky",
      "desc": "吸顶（position: sticky; top: 0）",
      "group": "layout"
    },
    {
      "class": "riko-banner--inline",
      "desc": "内容中的圆角虚线横幅（左对齐）",
      "group": "layout"
    }
  ],
  "states": [],
  "js": {
    "attr": "",
    "options": [
      {
        "attr": "data-riko-dismiss",
        "values": "（无值）",
        "desc": "放在关闭按钮上，点击后淡出移除横幅"
      }
    ],
    "methods": [
      {
        "signature": "Riko.dismiss(el)",
        "desc": "用 JS 移除"
      }
    ],
    "events": [
      {
        "name": "riko:dismiss",
        "detail": "{ target, trigger }",
        "desc": "移除前派发，可 preventDefault 阻止"
      }
    ]
  },
  "a11y": [
    "根元素加 role=\"region\" 与 aria-label（如「公告」），方便读屏用户跳转。",
    "图标加 aria-hidden=\"true\"；关闭按钮必须有 aria-label。"
  ],
  "rules": [
    "默认为橙色强调色调；整页顶部公告放在 <body> 最前面，需要时加 riko-banner--sticky。",
    "文字要短，一行说清；更多内容用 riko-banner__link 链接出去。"
  ],
  "avoid": [
    "不要在一个页面同时放多条横幅。",
    "不要在横幅里放表单或大量按钮。"
  ],
  "examples": [
    {
      "title": "页面顶部公告",
      "html": "<div class=\"riko-stack\">\n  <div class=\"riko-banner\" role=\"region\" aria-label=\"公告\">\n    <span class=\"riko-banner__icon riko-star\" aria-hidden=\"true\"></span>\n    <p class=\"riko-banner__text\">第 76 节「风过围垣，落星回响」已更新！<a class=\"riko-banner__link\" href=\"#\">去看看</a></p>\n    <button type=\"button\" class=\"riko-banner__close\" data-riko-dismiss aria-label=\"关闭公告\"></button>\n  </div>\n  <div class=\"riko-banner riko-banner--ice\" role=\"region\" aria-label=\"公告\">\n    <span class=\"riko-banner__icon\" aria-hidden=\"true\"><i data-lucide=\"snowflake\"></i></span>\n    <p class=\"riko-banner__text\">冬日限定：深色模式下的夜晚更安静哦。</p>\n  </div>\n</div>"
    },
    {
      "title": "内容中的圆角横幅",
      "html": "<div class=\"riko-banner riko-banner--inline riko-banner--warning\" role=\"region\" aria-label=\"维护通知\">\n  <span class=\"riko-banner__icon\" aria-hidden=\"true\"><i data-lucide=\"wrench\"></i></span>\n  <p class=\"riko-banner__text\">今晚 23:00–23:30 维护，届时阅读器可能短暂不可用。<a class=\"riko-banner__link\" href=\"#\">了解详情</a></p>\n</div>"
    }
  ],
  "requires": [
    {
      "selector": ".riko-banner",
      "has": ".riko-banner__text",
      "message": "riko-banner 内需要 riko-banner__text"
    },
    {
      "selector": ".riko-banner__close",
      "attr": "data-riko-dismiss",
      "message": "riko-banner__close 需要 data-riko-dismiss"
    },
    {
      "selector": ".riko-banner__close",
      "attr": "aria-label|aria-labelledby",
      "message": "riko-banner__close 需要 aria-label"
    }
  ],
  "related": [
    "alert",
    "toast"
  ]
}
