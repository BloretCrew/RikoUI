{
  "name": "progress",
  "title": "进度",
  "titleEn": "Progress",
  "category": "feedback",
  "summary": "基于原生 <progress> 的渐变进度条（支持不确定进度），以及带小星星的环形进度。",
  "when": "有明确进度的任务（上传、阅读进度、完成度）。不确定时长的等待也可用不写 value 的进度条或 spinner。",
  "root": "riko-progress",
  "element": "div",
  "parts": [
    {
      "class": "riko-progress__head",
      "desc": "标签行（标签 + 数值）"
    },
    {
      "class": "riko-progress__label",
      "desc": "标签（给 id，供 aria-labelledby）"
    },
    {
      "class": "riko-progress__value",
      "desc": "百分比文字"
    },
    {
      "class": "riko-progress__bar",
      "desc": "原生 <progress value max>；不写 value 为不确定进度",
      "required": true
    },
    {
      "class": "riko-progress-ring",
      "desc": "环形进度根元素：role=\"progressbar\" + aria-valuenow + style=\"--riko-progress: 0~100\""
    },
    {
      "class": "riko-progress-ring__value",
      "desc": "环形中间的数字"
    }
  ],
  "modifiers": [
    {
      "class": "riko-progress--sm",
      "desc": "细",
      "group": "size"
    },
    {
      "class": "riko-progress--lg",
      "desc": "粗",
      "group": "size"
    },
    {
      "class": "riko-progress--ice",
      "desc": "冰蓝",
      "group": "tone"
    },
    {
      "class": "riko-progress--success",
      "desc": "成功",
      "group": "tone"
    },
    {
      "class": "riko-progress--warning",
      "desc": "警告",
      "group": "tone"
    },
    {
      "class": "riko-progress--danger",
      "desc": "危险",
      "group": "tone"
    },
    {
      "class": "riko-progress-ring--sm",
      "desc": "环形小号",
      "group": "size"
    },
    {
      "class": "riko-progress-ring--lg",
      "desc": "环形大号",
      "group": "size"
    },
    {
      "class": "riko-progress-ring--ice",
      "desc": "环形冰蓝",
      "group": "tone"
    },
    {
      "class": "riko-progress-ring--success",
      "desc": "环形成功",
      "group": "tone"
    },
    {
      "class": "riko-progress-ring--warning",
      "desc": "环形警告",
      "group": "tone"
    },
    {
      "class": "riko-progress-ring--danger",
      "desc": "环形危险",
      "group": "tone"
    }
  ],
  "states": [
    {
      "attr": "value",
      "on": "riko-progress__bar",
      "desc": "当前值；更新时同时更新 __value 文字"
    },
    {
      "attr": "aria-valuenow",
      "on": "riko-progress-ring",
      "desc": "环形当前值，需与 --riko-progress 保持一致"
    }
  ],
  "js": null,
  "a11y": [
    "<progress> 需要可访问名称：aria-labelledby 指向 __label，或 aria-label。",
    "环形进度用 role=\"progressbar\" 并写 aria-valuenow / aria-valuemin / aria-valuemax / aria-label。"
  ],
  "rules": [
    "用 JS 更新：bar.value = 62；环形：ring.style.setProperty('--riko-progress', 62) 并同步 aria-valuenow。",
    "环形的 --riko-progress 是 0–100 的纯数字（不带 %）。"
  ],
  "avoid": [
    "不要用 div 宽度百分比自己画进度条。"
  ],
  "examples": [
    {
      "title": "进度条",
      "html": "<div class=\"riko-stack riko-stack--lg\">\n  <div class=\"riko-progress\">\n    <div class=\"riko-progress__head\">\n      <span class=\"riko-progress__label\" id=\"read-progress-label\">阅读进度</span>\n      <span class=\"riko-progress__value\">62%</span>\n    </div>\n    <progress class=\"riko-progress__bar\" value=\"62\" max=\"100\" aria-labelledby=\"read-progress-label\"></progress>\n  </div>\n  <div class=\"riko-progress riko-progress--sm riko-progress--success\">\n    <div class=\"riko-progress__head\">\n      <span class=\"riko-progress__label\" id=\"upload-progress-label\">画稿上传</span>\n      <span class=\"riko-progress__value\">100%</span>\n    </div>\n    <progress class=\"riko-progress__bar\" value=\"100\" max=\"100\" aria-labelledby=\"upload-progress-label\"></progress>\n  </div>\n  <div class=\"riko-progress riko-progress--lg riko-progress--ice\">\n    <progress class=\"riko-progress__bar\" value=\"35\" max=\"100\" aria-label=\"下载进度\"></progress>\n  </div>\n</div>"
    },
    {
      "title": "不确定进度",
      "html": "<div class=\"riko-progress\">\n  <div class=\"riko-progress__head\">\n    <span class=\"riko-progress__label\" id=\"sync-progress-label\">正在同步书签…</span>\n  </div>\n  <progress class=\"riko-progress__bar\" max=\"100\" aria-labelledby=\"sync-progress-label\"></progress>\n</div>"
    },
    {
      "title": "环形进度",
      "html": "<div class=\"riko-cluster riko-cluster--lg\">\n  <div class=\"riko-progress-ring riko-progress-ring--sm\" role=\"progressbar\" aria-valuenow=\"25\" aria-valuemin=\"0\" aria-valuemax=\"100\" aria-label=\"今日阅读\" style=\"--riko-progress: 25\"><span class=\"riko-progress-ring__value\">25%</span></div>\n  <div class=\"riko-progress-ring\" role=\"progressbar\" aria-valuenow=\"72\" aria-valuemin=\"0\" aria-valuemax=\"100\" aria-label=\"序章进度\" style=\"--riko-progress: 72\"><span class=\"riko-progress-ring__value\">72%</span></div>\n  <div class=\"riko-progress-ring riko-progress-ring--lg riko-progress-ring--ice\" role=\"progressbar\" aria-valuenow=\"90\" aria-valuemin=\"0\" aria-valuemax=\"100\" aria-label=\"第一章进度\" style=\"--riko-progress: 90\"><span class=\"riko-progress-ring__value\">90%</span></div>\n</div>"
    }
  ],
  "requires": [
    {
      "selector": ".riko-progress",
      "has": ".riko-progress__bar",
      "message": "riko-progress 内需要 <progress class=\"riko-progress__bar\">"
    },
    {
      "selector": ".riko-progress__bar",
      "attr": "aria-labelledby|aria-label",
      "message": "riko-progress__bar 需要 aria-labelledby 或 aria-label"
    },
    {
      "selector": ".riko-progress-ring",
      "attr": "aria-valuenow",
      "message": "riko-progress-ring 需要 role=\"progressbar\" 与 aria-valuenow"
    },
    {
      "selector": ".riko-progress-ring",
      "attr": "aria-label|aria-labelledby",
      "message": "riko-progress-ring 需要 aria-label"
    }
  ],
  "related": [
    "spinner",
    "skeleton"
  ]
}
